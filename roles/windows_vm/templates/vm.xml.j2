<domain type='kvm'>
  <name>{{ vm_name }}</name>
  <memory unit='MiB'>{{ vm_memory }}</memory>
  <currentMemory unit='MiB'>{{ vm_memory }}</currentMemory>
  <vcpu placement='static'>{{ vm_vcpus }}</vcpu>

  <os>
{% if vm_firmware == 'uefi' %}
    <type arch='x86_64' machine='{{ vm_machine_type }}'>hvm</type>
    <loader readonly='yes' type='pflash'>{{ vm_uefi_loader }}</loader>
{% else %}
    <type arch='x86_64' machine='{{ vm_machine_type }}'>hvm</type>
{% endif %}
{% if vm_boot_cdrom_first | default(true) %}
    <boot dev='cdrom'/>
    <boot dev='hd'/>
{% else %}
    <boot dev='hd'/>
    <boot dev='cdrom'/>
{% endif %}
  </os>

  <features>
    <acpi/>
    <apic/>
    <hyperv mode='custom'>
      <relaxed state='on'/>
      <vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
    </hyperv>
  </features>

  <cpu mode='host-passthrough' check='none' migratable='on'/>

  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
    <timer name='hypervclock' present='yes'/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>

  <devices>
    <!-- Disk: VirtIO for best performance -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' discard='unmap'/>
      <source file='{{ vm_disk_path }}'/>
      <target dev='vda' bus='virtio'/>
    </disk>

    <!-- Windows installation ISO -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='{{ windows_iso }}'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>

{% if virtio_iso is defined and virtio_iso | length > 0 %}
    <!-- VirtIO driver ISO -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='{{ virtio_iso }}'/>
      <target dev='sdb' bus='sata'/>
      <readonly/>
    </disk>
{% endif %}

    <!-- Network interface -->
    <interface type='network'>
      <source network='{{ vm_network }}'/>
      <model type='{{ vm_network_model }}'/>
    </interface>

    <!-- Graphics: SPICE for remote console access -->
    <graphics type='spice' autoport='yes'>
      <listen type='address' address='0.0.0.0'/>
    </graphics>

    <!-- Video -->
    <video>
      <model type='qxl' ram='65536' vram='65536' vgamem='16384' heads='1' primary='yes'/>
    </video>

    <!-- Input devices -->
    <input type='tablet' bus='usb'/>
    <input type='keyboard' bus='usb'/>

    <!-- USB controller -->
    <controller type='usb' model='qemu-xhci' ports='15'/>

    <!-- Serial console for debugging -->
    <serial type='pty'>
      <target port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>

    <!-- Channel for QEMU guest agent (future use) -->
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>

    <!-- RNG device for better entropy in the guest -->
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
  </devices>
</domain>
